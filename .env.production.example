APP_NAME="Edu Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rod-api.ghvcameroon.com
FRONTEND_URL=https://rod.ghvcameroon.com
CORS_ALLOWED_ORIGINS=https://rod.ghvcameroon.com,https://rod-api.ghvcameroon.com,http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_DATABASE_NAME
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ghvcameroon.com

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ghvcameroon.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Biometric device MQTT
MQTT_HOST=YOUR_MQTT_HOST
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=edu-connect
MQTT_USE_TLS=false
MQTT_LOG_ALL_MESSAGES=false
MQTT_LOG_UNKNOWN_MESSAGES=false

# Realtime broadcasting.
# Recommended for shared cPanel: use a managed Pusher-compatible provider.
# PUSHER_* is used by Laravel to publish events to the provider REST/API endpoint.
# REALTIME_* is returned to mobile/web clients for websocket connections.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-mt1.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

REALTIME_ENABLED=true
REALTIME_DRIVER=pusher
REALTIME_APP_KEY="${PUSHER_APP_KEY}"
REALTIME_APP_SECRET="${PUSHER_APP_SECRET}"
REALTIME_HOST=ws-mt1.pusher.com
REALTIME_PORT=443
REALTIME_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${REALTIME_HOST}"
VITE_PUSHER_PORT="${REALTIME_PORT}"
VITE_PUSHER_SCHEME="${REALTIME_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Edu-admin integration connections are stored in the database.
# Use the Edu-admin API root URL when creating the production Edu-admin connection.
# The connector appends /api/v1/integrations/edu-connect/... automatically.
# https://eduadmin-api.ghvcameroon.com
EDU_ADMIN_CONNECTOR_DRIVER=http
EDU_ADMIN_CONNECTOR_API_VERSION=v1
EDU_ADMIN_CONNECTOR_TIMEOUT=15
EDU_ADMIN_CONNECTOR_RETRIES=3

# Mobile push
PUSH_PROVIDER=fcm
PUSH_TRANSPORT=provider
PUSH_PRIVACY_MODE=discreet
PUSH_TIMEOUT_SECONDS=10
PUSH_MAX_ATTEMPTS=3
PUSH_RETRY_BACKOFF_SECONDS=300
PUSH_MAX_RETRY_BACKOFF_SECONDS=3600

# Firebase Cloud Messaging HTTP v1. Keep service-account JSON outside public_html.
FCM_PROJECT_ID=n3rod-4fb80
FCM_ACCESS_TOKEN=
FCM_CREDENTIALS_PATH=/home/CPANEL_USER/secure/firebase/n3rod-4fb80-firebase-adminsdk.json
FCM_CREDENTIALS_JSON=

# Apple Push Notification service, if iOS remote pushes are enabled directly via APNS.
APNS_ENVIRONMENT=production
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.queevo.educonnect
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
APNS_BEARER_TOKEN=
