# ============================================
# MQTT Broker Configuration
# ============================================
# This file shows the MQTT configuration needed in your .env file

# MQTT Broker Host
# For public test broker: test.mosquitto.org
# For local broker: 192.168.1.137 or localhost
MQTT_HOST=test.mosquitto.org

# MQTT Broker Port
# Standard: 1883 (non-TLS)
# TLS: 8883
MQTT_PORT=1883

# MQTT Authentication (optional for public brokers)
# Leave empty for public brokers like test.mosquitto.org
# Set values for private/secured brokers
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT Client ID Prefix
# Used to identify this application's connections
MQTT_CLIENT_ID_PREFIX=rod-connect

# MQTT TLS/SSL Configuration (optional)
MQTT_USE_TLS=false
MQTT_CA_FILE=
MQTT_CERT_FILE=
MQTT_KEY_FILE=
MQTT_VERIFY_PEER=true

# MQTT Logging (optional)
MQTT_LOG_ALL_MESSAGES=false
MQTT_LOG_UNKNOWN_MESSAGES=true

# ============================================
# Example Configurations
# ============================================

# Example 1: Public Test Broker (Mosquitto)
# MQTT_HOST=test.mosquitto.org
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Example 2: Local Development Broker
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_USERNAME=admin
# MQTT_PASSWORD=your_password

# Example 3: Production Broker with TLS
# MQTT_HOST=mqtt.yourcompany.com
# MQTT_PORT=8883
# MQTT_USERNAME=prod_user
# MQTT_PASSWORD=secure_password
# MQTT_USE_TLS=true
# MQTT_CA_FILE=/path/to/ca.crt
# MQTT_VERIFY_PEER=true

# ============================================
# Notes
# ============================================
# 1. Copy these settings to your .env file
# 2. Update values according to your MQTT broker
# 3. Never commit .env file to version control
# 4. For public brokers, leave username/password empty
# 5. Test connection with: php test_mqtt_auth.php
